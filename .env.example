# ─── Server ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Set to true when running behind a reverse proxy / load balancer so client IPs are correct
TRUST_PROXY=false
# live = the actual application data (LIVE_DB_NAME). mock = development and testing data (MOCK_DB_NAME).
# `npm run dev:mock` / `--mock` selects mock without editing this file. Mock is refused in production.
DATA_SOURCE=live

# ─── PostgreSQL (manage it with pgAdmin 4; the API connects to the server directly) ─
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_SSL=false
# Live data — the actual application data
LIVE_DB_NAME=miata_live_db
# Mock data for development and testing (loaded from database/mock-data by `npm run db:mock`).
# `npm test` rebuilds it and reloads the mock data afterwards — never point it at live data.
MOCK_DB_NAME=miata_mock_db

# ─── Authentication ──────────────────────────────────────────────────────
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_REFRESH_TTL_HOURS=12
BCRYPT_ROUNDS=12
# Secure (HTTPS-only) cookies. Defaults to true in production and whenever COOKIE_SAMESITE=none.
COOKIE_SECURE=
# lax = miata-web and the API share a site (same domain, other port/subdomain). none = different domains (HTTPS required).
COOKIE_SAMESITE=lax

# ─── miata-web (frontend) ────────────────────────────────────────────────
# Public URL of miata-web: allowed CORS origin and the base of links in emails (reset, referral, login)
FRONTEND_URL=http://localhost:5173
# Extra allowed origins, comma separated
CORS_ORIGINS=

# ─── File uploads ────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MOCK_UPLOAD_DIR=./uploads-mock
MAX_VIDEO_SIZE_MB=1024
MAX_DOCUMENT_SIZE_MB=20

# ─── Email (SMTP). Leave SMTP_HOST empty to disable sending — emails are then recorded as "skipped" ─
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Who receives new-enquiry notifications (comma separated)
ENQUIRY_NOTIFY_EMAIL=
# Time zone for dates and times written in e-mails (online class invitations), as an IANA name such as Asia/Kolkata or
# Australia/Melbourne. Empty = the server's time zone.
APP_TIMEZONE=

# Course access periods: students whose last course has ended are deactivated automatically. The server checks every
# this many minutes (and again whenever a student signs in). The day boundary follows APP_TIMEZONE.
ACCESS_EXPIRY_CHECK_MINUTES=60
