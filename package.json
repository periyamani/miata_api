{
  "name": "miata-api",
  "version": "1.0.0",
  "private": true,
  "description": "MIATA REST API (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:mock": "node src/server.js --mock",
    "dev": "node --watch src/server.js",
    "dev:mock": "node --watch src/server.js --mock",
    "db:setup": "node scripts/db-setup.js",
    "migrate": "node scripts/db-setup.js",
    "db:mock": "node scripts/load-mock-data.js",
    "db:seed": "node scripts/load-mock-data.js",
    "db:compare": "node scripts/compare-databases.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node scripts/run-tests.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" eslint.config.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
